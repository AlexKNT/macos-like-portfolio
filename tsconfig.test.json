{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",

    /* A test may read a file (the stylesheet, the document) and reach the working
       directory; application code may not, which is why this is its own project. */
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test"],

  /* The application project excludes these files; this project is the one that owns them. */
  "exclude": []
}
